# ---------------------------------------------------------------------------
# Copy this file to .env for local Docker development and fill in your own
# values. Never commit the real .env file or upload it to a web host.
# ---------------------------------------------------------------------------

# Local Docker development uses MySQL/MariaDB.
DB_DRIVER=mysql
DB_ROOT_PASSWORD=change-this-root-password
DB_NAME=srms_db
DB_USER=srms_user
DB_PASSWORD=change-this-app-password
DB_HOST=db
DB_PORT=3306

APP_DEBUG=true
APP_URL=

# Render Postgres example (the Render CLI/dashboard injects these values):
# DB_DRIVER=pgsql
# DB_HOST=dpg-xxxxxxxxxxxx-a
# DB_PORT=5432
# DB_NAME=srms
# DB_USER=srms
# DB_PASSWORD=...
# DB_SSLMODE=prefer
